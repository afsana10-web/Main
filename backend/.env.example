# Copy this file to .env and fill in real values before deploying.

# For local prototype/demo, SQLite works out of the box:
DATABASE_URL=sqlite:///./parakh.db
# For production, use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://parakh_user:CHANGE_ME@localhost:5432/parakh

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480

UPLOAD_DIR=uploads
REPORT_DIR=generated_reports

# Leave blank to use tesseract from system PATH
TESSERACT_CMD=

RULES_CONFIG_PATH=../compliance-rules/rules.json

DEMO_MODE=true
